{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clasp.team102/schemas/eval_result.schema.json",
  "title": "CLASP Evaluation Result",
  "description": "P5 -> P4/dashboard. Pass@k outcome for one adapter on one benchmark. Shape frozen in Week 2; values populated from Week 3 when Pass@k scoring lands.",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter", "benchmark", "pass_at_k", "num_tasks", "num_samples_per_task", "contract_version"],
  "properties": {
    "adapter": { "$ref": "#/$defs/adapter_ref" },
    "benchmark": {
      "type": "string",
      "enum": ["HumanEval", "MBPP"]
    },
    "pass_at_k": {
      "type": "object",
      "description": "Map of k (as a string key) to the pass@k rate in [0, 1].",
      "propertyNames": { "pattern": "^[1-9][0-9]*$" },
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "num_tasks": { "type": "integer", "minimum": 0 },
    "num_samples_per_task": { "type": "integer", "minimum": 1 },
    "created_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "run_id": { "type": ["string", "null"] },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  },
  "$defs": {
    "adapter_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "enum": ["client", "cluster"] },
        "cluster_id": { "type": ["string", "null"] }
      }
    }
  }
}
