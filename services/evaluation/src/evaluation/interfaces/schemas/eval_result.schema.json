{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clasp.team102/schemas/eval_result.schema.json",
  "title": "CLASP Evaluation Result",
  "description": "P5 -> P4/dashboard. Evaluation outcome for one candidate adapter. `pass_at_k` is the D5 regression guard; `in_project` is the D5 primary metric (edit similarity / exact match over held-out client files) and is optional so a guard-only document still validates. Shape frozen in Week 2; `pass_at_k` populated from Week 3, `in_project` from the in-project-eval-v1 deliverable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter", "benchmark", "pass_at_k", "num_tasks", "num_samples_per_task", "contract_version"],
  "properties": {
    "adapter": { "$ref": "#/$defs/adapter_ref" },
    "benchmark": {
      "type": "string",
      "enum": ["HumanEval", "MBPP"]
    },
    "pass_at_k": {
      "type": "object",
      "description": "Map of k (as a string key) to the pass@k rate in [0, 1].",
      "propertyNames": { "pattern": "^[1-9][0-9]*$" },
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "num_tasks": { "type": "integer", "minimum": 0 },
    "num_samples_per_task": { "type": "integer", "minimum": 1 },
    "created_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "run_id": { "type": ["string", "null"] },
    "in_project": {
      "description": "D5 primary metric. null when only the guard was evaluated.",
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/in_project_metrics" }
      ]
    },
    "baseline_noise_band": {
      "type": "number",
      "minimum": 0,
      "description": "Smallest in-project improvement distinguishable from run-to-run noise, from >= 2 repeated baseline evals. 0.0 = not yet measured (or a deterministic backend)."
    },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  },
  "$defs": {
    "adapter_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "enum": ["client", "cluster"] },
        "cluster_id": { "type": ["string", "null"] }
      }
    },
    "in_project_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edit_similarity", "exact_match", "n_examples"],
      "properties": {
        "edit_similarity": { "type": "number", "minimum": 0, "maximum": 1 },
        "exact_match": { "type": "number", "minimum": 0, "maximum": 1 },
        "n_examples": { "type": "integer", "minimum": 0 },
        "perplexity": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "description": "P1's held-out perplexity in the integrated pipeline; null when P5 runs standalone (no logits)."
        }
      }
    }
  }
}
