{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clasp.team102/schemas/partition_manifest.schema.json",
  "title": "CLASP Partition Manifest",
  "description": "P5 -> P1/P2/P4. Declares the federated client topology derived from the D1 corpus. Week-2 Thursday deliverable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "strategy",
    "seed",
    "created_at",
    "corpus_path",
    "corpus_sha256",
    "num_clients",
    "num_clusters",
    "total_files",
    "cluster_ids",
    "shards",
    "contract_version"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "description": "Semantic version of this manifest document.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "strategy": {
      "type": "string",
      "description": "Partitioning scheme. Only project_level is implemented in Week 2.",
      "enum": ["project_level", "per_developer"]
    },
    "seed": {
      "type": "integer",
      "description": "RNG seed pinning this partition for reproducibility.",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp with a trailing Z.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "corpus_path": {
      "type": "string",
      "description": "Repo-relative path of the corpus JSONL this partition was derived from.",
      "minLength": 1
    },
    "corpus_sha256": {
      "type": "string",
      "description": "SHA-256 of the corpus file, pinning the exact input bytes.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "num_clients": {
      "type": "integer",
      "description": "Number of federated clients; must equal the shard count.",
      "minimum": 1
    },
    "num_clusters": {
      "type": "integer",
      "description": "Number of distinct projects (clusters).",
      "minimum": 1
    },
    "total_files": {
      "type": "integer",
      "description": "Total assigned files; must equal the sum over shards.",
      "minimum": 1
    },
    "cluster_ids": {
      "type": "array",
      "description": "Sorted, unique cluster identifiers.",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "minItems": 1
    },
    "shards": {
      "type": "array",
      "description": "One entry per federated client.",
      "minItems": 1,
      "items": { "$ref": "#/$defs/shard" }
    },
    "contract_version": {
      "type": "string",
      "description": "Version of the CLASP contracts package this document targets.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "$defs": {
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_id",
        "cluster_id",
        "project_label",
        "num_files",
        "num_lines",
        "num_code_lines",
        "total_bytes",
        "files_path",
        "content_sha256"
      ],
      "properties": {
        "client_id": {
          "type": "string",
          "description": "Flower client identifier. Unique across the manifest.",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "cluster_id": {
          "type": "string",
          "description": "Project/cluster this client belongs to.",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "project_label": {
          "type": "string",
          "description": "Human-readable project name.",
          "minLength": 1
        },
        "num_files": { "type": "integer", "minimum": 1 },
        "num_lines": { "type": "integer", "minimum": 0 },
        "num_code_lines": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "files_path": {
          "type": "string",
          "description": "Repo-relative JSONL holding this shard's file records.",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "description": "SHA-256 over the shard's ordered file hashes.",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
